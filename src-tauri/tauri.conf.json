{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "myWaves",
  "version": "1.3.0",
  "identifier": "com.mywaves.desktop.tauri",
  "build": {
    "frontendDist": "../dist-electron",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:electron"
  },
  "app": {
    "windows": [
      {
        "title": "myWaves — Conditions marines",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0NTM2N0FENUIwRTU1QkUKUldTK1ZRNWJyV2RUdE9GcW5ienFTSWcxRVQ2OEJmUlROck5RZTc3ZlNVVEsvM0FwdFVDTjRNaEwK",
      "endpoints": [
        "https://github.com/Netapick/myWaves/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "languages": ["French"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
